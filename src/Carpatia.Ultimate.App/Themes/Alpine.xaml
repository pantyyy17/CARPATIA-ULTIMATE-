<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AlpineBackground" Color="#EEF4FC" />
      <SolidColorBrush x:Key="AlpineSidebar" Color="#F5F8FE" />
      <SolidColorBrush x:Key="AlpineSurface" Color="#ECFFFFFF" />
      <SolidColorBrush x:Key="AlpineSubtle" Color="#F3F7FE" />
      <SolidColorBrush x:Key="AlpineBorder" Color="#DFE8F5" />
      <SolidColorBrush x:Key="AlpineInk" Color="#10213C" />
      <SolidColorBrush x:Key="AlpineMuted" Color="#536782" />
      <SolidColorBrush x:Key="AlpineHeroTint" Color="#E7F0FE" />
      <SolidColorBrush x:Key="AlpineBlue" Color="#0968EE" />
      <LinearGradientBrush x:Key="AlpineHeroOverlay" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#EFF5FF" Offset="0" /><GradientStop Color="#E6EFF5FF" Offset="0.33" /><GradientStop Color="#00EFF5FF" Offset="0.85" /></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AlpineBackground" Color="#111B2B" />
      <SolidColorBrush x:Key="AlpineSidebar" Color="#142035" />
      <SolidColorBrush x:Key="AlpineSurface" Color="#ED1B2B42" />
      <SolidColorBrush x:Key="AlpineSubtle" Color="#20314B" />
      <SolidColorBrush x:Key="AlpineBorder" Color="#34445E" />
      <SolidColorBrush x:Key="AlpineInk" Color="#F1F6FF" />
      <SolidColorBrush x:Key="AlpineMuted" Color="#A6B8D0" />
      <SolidColorBrush x:Key="AlpineHeroTint" Color="#182A43" />
      <SolidColorBrush x:Key="AlpineBlue" Color="#78B8FF" />
      <LinearGradientBrush x:Key="AlpineHeroOverlay" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#182A43" Offset="0" /><GradientStop Color="#F0182A43" Offset="0.33" /><GradientStop Color="#60182A43" Offset="0.85" /></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AlpineBackground" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AlpineSidebar" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AlpineSurface" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AlpineSubtle" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AlpineBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AlpineInk" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AlpineMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AlpineHeroTint" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AlpineBlue" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AlpineHeroOverlay" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AlpineSurface}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AlpineBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style x:Key="PageHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AlpineInk}" />
  </Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AlpineInk}" />
  </Style>
  <Style x:Key="BodyMuted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource AlpineMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="160" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <DataTemplate x:Key="FeatureTemplate">
    <Border BorderBrush="{ThemeResource AlpineBorder}" BorderThickness="0,0,0,1" Padding="0,20">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="7">
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" />
          <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMuted}" />
        </StackPanel>
        <Border Grid.Column="1" Background="{ThemeResource AlpineSubtle}" BorderBrush="{ThemeResource AlpineBorder}" BorderThickness="1" CornerRadius="7" Padding="10,5" VerticalAlignment="Top">
          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource AlpineMuted}" />
        </Border>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
