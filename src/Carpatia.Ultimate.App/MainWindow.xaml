<Window x:Class="Carpatia.Ultimate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CARPATIA ULTIMATE EDITION">
  <Grid x:Name="Root" Background="{ThemeResource AlpineBackground}" RequestedTheme="Light">
    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="TitleDragArea" Margin="18,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE753;" FontSize="13" Foreground="{ThemeResource AlpineBlue}" />
        <TextBlock Text="CARPATIA ULTIMATE EDITION" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource AlpineMuted}" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
                    OpenPaneLength="228" CompactPaneLength="64"
                    CompactModeThresholdWidth="850" ExpandedModeThresholdWidth="1120"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="Navigation_SelectionChanged"
                    Background="{ThemeResource AlpineBackground}">
      <NavigationView.PaneHeader>
        <StackPanel Margin="22,22,16,25" Spacing="6">
          <Viewbox Height="49" Width="84" HorizontalAlignment="Left" Margin="0,0,0,9" AutomationProperties.Name="Carpatia mountain emblem">
            <Canvas Width="100" Height="58">
              <Path Fill="#0968EE" Data="M 0,54 L 30,23 L 36,29 L 58,0 L 100,54 L 67,32 L 75,46 L 57,30 L 48,39 L 54,17 L 36,40 L 31,34 Z" />
              <Path Fill="#7BC2FF" Data="M 58,0 L 65,25 L 58,19 L 53,29 L 54,17 Z" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="CARPATIA" FontSize="23" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource AlpineInk}" />
          <TextBlock Text="ULTIMATE EDITION" FontSize="10" FontWeight="SemiBold" CharacterSpacing="200" Foreground="{ThemeResource AlpineBlue}" />
          <TextBlock Text="Windows, thoughtfully tuned." FontSize="11" Foreground="{ThemeResource AlpineMuted}" Margin="0,8,0,0" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Dashboard" Tag="Dashboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Optimization" Tag="Optimization"><NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="System Tweaks" Tag="System Tweaks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Debloat" Tag="Debloat"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Windows Services" Tag="Windows Services"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Backup &amp; Restore" Tag="Backup &amp; Restore"><NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="24,18,12,24" Spacing="7">
          <TextBlock Text="ALPINE EDITION" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="1.0.0 · Phase B preview" FontSize="11" Foreground="{ThemeResource AlpineMuted}" />
        </StackPanel>
      </NavigationView.PaneFooter>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid Padding="24,12,28,28" MaxWidth="1600" HorizontalAlignment="Stretch">
          <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
