<UserControl x:Class="Carpatia.Ultimate.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carpatia.Ultimate.App.ViewModels">
  <StackPanel Spacing="18">
    <Grid MinHeight="228" CornerRadius="20" AutomationProperties.Name="Alpine mountain header">
      <Grid.Background><ImageBrush ImageSource="ms-appx:///Assets/alpine.jpg" Stretch="UniformToFill" Opacity="0.62" /></Grid.Background>
      <Rectangle Fill="{ThemeResource AlpineHeroOverlay}" />
      <StackPanel Margin="30,32,24,20" Spacing="12" MaxWidth="670" HorizontalAlignment="Left">
        <TextBlock Text="YOUR WINDOWS, REFINED." FontSize="11" FontWeight="SemiBold" CharacterSpacing="230" Foreground="{ThemeResource AlpineMuted}" />
        <TextBlock FontSize="38" FontWeight="SemiBold" Foreground="{ThemeResource AlpineInk}" TextWrapping="Wrap" MaxWidth="630">
          <Run Text="A clearer view." /><LineBreak /><Run Text="A better Windows." Foreground="{ThemeResource AlpineBlue}" />
        </TextBlock>
        <TextBlock Text="Optimize · Understand · Restore" FontSize="15" Foreground="{ThemeResource AlpineMuted}" />
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource Card}" Padding="22,18">
      <Grid ColumnSpacing="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
          <FontIcon Glyph="&#xE782;" Foreground="{ThemeResource AlpineBlue}" FontSize="30" />
          <StackPanel Spacing="3"><TextBlock Text="WINDOWS" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.OperatingSystem, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="CPU" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="MEMORY" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.MemoryUsage, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
        <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="GPU" Style="{StaticResource Eyebrow}" /><TextBlock Text="—" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AlpineInk}" ToolTipService.ToolTip="GPU telemetry provider is not yet integrated." /></StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="SummaryGrid" ColumnSpacing="18" RowSpacing="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1150" /></VisualState.StateTriggers></VisualState>
          <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="ProfilePanel.(Grid.Column)" Value="0" /><Setter Target="ProfilePanel.(Grid.Row)" Value="1" /><Setter Target="ReviewPanel.(Grid.ColumnSpan)" Value="2" /><Setter Target="ProfilePanel.(Grid.ColumnSpan)" Value="2" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="ReviewPanel" Style="{StaticResource Card}">
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="54" Height="54" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"><FontIcon Glyph="&#xE945;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="25" /></Border>
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Make every change intentional." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" />
            <TextBlock Text="Understand your system. Review compatible settings and preserve the original configuration before applying a change." Style="{StaticResource BodyMuted}" />
            <Button Style="{StaticResource PrimaryButton}" Click="Review_Click" Margin="0,3,0,0"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Review Optimizations" /><FontIcon Glyph="&#xE72A;" FontSize="12" /></StackPanel></Button>
            <TextBlock Text="Individual changes · Review and verification required" FontSize="11" Foreground="{ThemeResource AlpineMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ProfilePanel" Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8F1;" FontSize="17" Foreground="{ThemeResource AlpineBlue}" /><TextBlock Text="PROFILE TO REVIEW" Style="{StaticResource Eyebrow}" /></StackPanel>
          <ComboBox x:Name="ProfilePicker" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Profile_SelectionChanged" AutomationProperties.Name="Profile to review" FontSize="20" FontWeight="SemiBold">
            <x:String>Balanced</x:String><x:String>Performance</x:String><x:String>Ultra</x:String><x:String>Custom</x:String>
          </ComboBox>
          <TextBlock Text="{x:Bind ViewModel.ProfileDescription, Mode=OneWay}" Style="{StaticResource BodyMuted}" />
          <TextBlock Text="Full profile: Not applied · individual review available" FontSize="12" Foreground="{ThemeResource AlpineMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource Card}">
      <StackPanel Spacing="18">
        <Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource AlpineBlue}" /><TextBlock Text="Your system, at a glance" Style="{StaticResource SectionHeading}" /></StackPanel>
          <Button HorizontalAlignment="Right" Click="Refresh_Click" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" AutomationProperties.Name="Refresh hardware readings" ToolTipService.ToolTip="Read hardware and sample utilization once"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
        </Grid>
        <Grid ColumnSpacing="32" RowSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="5"><TextBlock Text="PROCESSOR" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="MEMORY" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.MemoryDescription, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
          <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="GRAPHICS" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="SYSTEM DRIVE" Style="{StaticResource Eyebrow}" /><TextBlock Text="{x:Bind ViewModel.StorageDescription, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AlpineInk}" /></StackPanel>
        </Grid>
        <Grid><TextBlock Text="{x:Bind ViewModel.SampleTime, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AlpineMuted}" /><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Right" /></Grid>
        <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="Diagnostics" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel Spacing="16">
        <Grid><TextBlock Text="Recent activity" Style="{StaticResource SectionHeading}" /><HyperlinkButton Content="Recovery records" HorizontalAlignment="Right" Click="Recovery_Click" /></Grid>
        <TextBlock Text="Readings from this session. Persistent system-change history is kept in the recovery journal." Style="{StaticResource BodyMuted}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Activity}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ActivityItem"><Grid Margin="0,5" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AlpineBlue}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource AlpineInk}" /><TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyMuted}" FontSize="12" /></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Timestamp}" Foreground="{ThemeResource AlpineMuted}" FontSize="12" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Text="Minimal interface. Maximum control. Zero unnecessary bloat." HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource AlpineMuted}" Margin="0,2,0,0" />
  </StackPanel>
</UserControl>
